{
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "dependencies": {
    "@motionstudies/core": "1.0.0",
    "@motionstudies/three": "1.0.0",
    "@motionstudies/web": "1.0.0",
    "@react-three/fiber": "9.8.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@motionstudies/data": "1.0.0",
    "@playwright/test": "1.65.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "oxlint": "1.93.0",
    "polygon-clipping": "0.15.7",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0",
    "@motionstudies/tooling": "1.0.0"
  },
  "packageManager": "npm@12.2.2",
  "name": "umlauf",
  "version": "0.0.0",
  "private": true,
  "description": "Umlauf — a Berlin motion study",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4177",
    "build": "tsc -p . && vite build",
    "typecheck": "tsc -p .",
    "data:compile": "node scripts/compile-vbb.mjs && node scripts/compile-layout.mjs && node scripts/compile-ostkreuz.mjs && node scripts/compile-atkis.mjs && npm run data:water",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "lint": "oxlint src scripts tests",
    "check:boundary": "node scripts/check-boundary.mjs",
    "data:ostkreuz": "node scripts/compile-ostkreuz.mjs",
    "data:atkis": "node scripts/compile-atkis.mjs",
    "data:water": "node scripts/compile-water.mjs",
    "profile:frames": "node scripts/profile-frames.mjs",
    "check:budget": "node scripts/check-budget.mjs",
    "check:stack": "node scripts/check-stack.mjs"
  }
}
